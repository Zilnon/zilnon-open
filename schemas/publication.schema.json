{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zilnon:publication:1.0.0",
  "title": "Zilnon public publication 1.0.0",
  "description": "Allowlisted report publication. Additional application validation requires public source URLs, unique report/source identities, existing citation references, watchlist membership, and ordered timezone-aware report timestamps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "published_at",
    "watchlist",
    "reports"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "watchlist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "name"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "symbols",
          "as_of",
          "generated_at",
          "published_at",
          "status",
          "review_status",
          "demo",
          "summary",
          "sections",
          "metrics",
          "sources",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(fundamental|news|social)-[a-z0-9-]+$"
          },
          "kind": {
            "enum": [
              "fundamental",
              "news",
              "social"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "const": "complete"
          },
          "review_status": {
            "const": "unreviewed"
          },
          "demo": {
            "type": "boolean"
          },
          "summary": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "paragraphs"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1
                },
                "paragraphs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text",
                      "kind",
                      "source_ids"
                    ],
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "enum": [
                          "interpretation",
                          "research_question",
                          "source_claim",
                          "source_fact",
                          "summary",
                          "uncertainty"
                        ]
                      },
                      "source_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      }
                    }
                  }
                }
              }
            }
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "value",
                "unit",
                "period",
                "source_ids"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "period": {
                  "type": "string",
                  "minLength": 1
                },
                "source_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "url",
                "publisher",
                "published_at",
                "published_date",
                "publication_precision"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "publisher": {
                  "type": "string",
                  "minLength": 1
                },
                "published_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "published_date": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "publication_precision": {
                  "enum": [
                    "date",
                    "timestamp",
                    null
                  ]
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
