---
import Layout from '../../layouts/Layout.astro';
import { reports, labels, paragraphLabels, date, calendarDate } from '../../lib/publication';
export function getStaticPaths() { return reports.map(report => ({ params: { id: report.id }, props: { report } })); }
const { report } = Astro.props;
const citationNumber = (id: string) => report.sources.findIndex(source => source.id === id) + 1;
---
<Layout title={report.title} description={report.summary}>
  <div class="breadcrumb"><a href="/archive/">Research archive</a><span aria-hidden="true">/</span><span>{labels[report.kind]}</span></div>
  <article class="report-page"><header class="article-header"><h1>{report.title}</h1><p class="article-summary">{report.summary}</p><div class="article-symbols">{report.symbols.map(symbol => <a href={`/companies/${symbol}/`}>{symbol}</a>)}</div><p class="review-status">Generated report · Unreviewed{report.demo ? ' · Synthetic demonstration' : ''}</p><dl class="timestamps"><div><dt>Evidence as of</dt><dd><time datetime={new Date(report.as_of).toISOString()}>{date(report.as_of, true)}</time></dd></div><div><dt>Generated</dt><dd><time datetime={new Date(report.generated_at).toISOString()}>{date(report.generated_at, true)}</time></dd></div><div><dt>Published</dt><dd><time datetime={new Date(report.published_at).toISOString()}>{date(report.published_at, true)}</time></dd></div></dl></header>
  <div class="article-grid"><aside class="article-contents"><nav aria-label="Report contents"><h2>In this report</h2>{report.sections.map((section, index) => <a href={`#section-${index}`}>{section.heading}</a>)}{report.metrics.length > 0 && <a href="#metrics">Reported figures</a>}<a href="#sources">Sources</a><a href="#limitations">Limitations</a></nav></aside><div class="article-body">{report.demo && <p class="inline-notice"><strong>Synthetic example.</strong> This report demonstrates structure and reading flow. Its narrative is illustrative and makes no claim about current company performance.</p>}{report.sections.map((section, index) => <section id={`section-${index}`}><h2>{section.heading}</h2>{section.paragraphs.map(paragraph => <div class="research-paragraph"><span class="paragraph-kind">{paragraphLabels[paragraph.kind]}</span><p>{paragraph.text}{paragraph.source_ids.length > 0 && <span class="citations"> {paragraph.source_ids.map(id => <a href={`#source-${citationNumber(id)}`} aria-label={`See source ${citationNumber(id)}`}>[{citationNumber(id)}]</a>)}</span>}</p></div>)}</section>)}
  {report.metrics.length > 0 && <section id="metrics"><h2>Reported figures</h2><div class="table-scroll"><table><thead><tr><th scope="col">Metric</th><th scope="col">Value</th><th scope="col">Unit</th><th scope="col">Period</th><th scope="col">Sources</th></tr></thead><tbody>{report.metrics.map(metric => <tr><th scope="row">{metric.label}</th><td>{metric.value}</td><td>{metric.unit}</td><td>{metric.period}</td><td>{metric.source_ids.map(id => <a href={`#source-${citationNumber(id)}`}>[{citationNumber(id)}]</a>)}</td></tr>)}</tbody></table></div></section>}
  <section id="sources"><h2>Sources</h2>{report.sources.length ? <ol class="source-list">{report.sources.map(source => <li id={`source-${citationNumber(source.id)}`}><span class="source-id">[{citationNumber(source.id)}]</span><div><a href={source.url} rel="noreferrer">{source.title} ↗</a><p>{source.publisher} · {source.publication_precision === 'date' && source.published_date ? <><time datetime={source.published_date}>{calendarDate(source.published_date)}</time> · Date only</> : source.published_at ? <time datetime={new Date(source.published_at).toISOString()}>{date(source.published_at, true)}</time> : 'Publication date not provided'}</p></div></li>)}</ol> : <p>No source citations were included in this report.</p>}</section>
  <section id="limitations"><h2>Limitations & open questions</h2><ul class="limitations">{report.limitations.map(item => <li>{item}</li>)}</ul><p class="page-note">Generated and unreviewed. Verify material claims against original sources before drawing conclusions.</p></section>
  </div></div></article><div class="article-end"><a href="/archive/">← Back to all research</a><a href="/about/">About the methodology →</a></div>
</Layout>
